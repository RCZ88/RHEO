  "content": "// ============================================================\n// DeskFlow — MonthWall (3D Month Calendar)\n// Gold Page → Life Phases → Schedule section\n// Skills: Human-Centric UX (all 4 states, delete+undo, feedback),\n//         Impeccable (8px grid, category hues from CATEGORY_COLORS only),\n//         Motion — L2 liveliness (spring micro-interactions),\n//         frontend-external-infra (Radix Popover, base-ui Select, lucide icons)\n// ============================================================\n\nimport { useState, useEffect, useMemo, useRef } from 'react';\nimport { motion, AnimatePresence } from 'motion/react';\nimport {\n  ChevronLeft, ChevronRight, Plus, Trash2, X, CalendarDays, Sun\n} from 'lucide-react';\nimport { Popover, PopoverTrigger, PopoverContent } from '../ui/popover';\nimport { Select, SelectItem } from '../ui/select';\nimport { CATEGORY_COLORS } from '../../lib/CategoryColors';\n\nconsole.log('%c[MonthWall] v1.0 loaded', 'color: #fbbf24; font-weight: bold');\n\nconst DAY_LETTER = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\nconst STORAGE_KEY = 'df-monthwall-events';\n\nconst ACCENT = '#f59e0b';\nconst ACCENT_SOFT = 'rgba(245, 158, 11, 0.12)';\n\nexport function localDateKey(d: Date): string {\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  return `${y}-${m}-${day}`;\n}\n\ninterface WallEvent {\n  id: string;\n  date: string;      // YYYY-MM-DD\n  title: string;\n  category: string;  // key into CATEGORY_COLORS\n  time?: string;     // HH:mm\n  createdAt: string;\n}\n\ninterface MonthWallProps {\n  accent?: string;\n  onMonthChange?: (month: string) => void; // 'YYYY-MM'\n  renderDay?: (dayData: { date: string; events: WallEvent[]; isToday: boolean; isPast: boolean }) => React.ReactNode;\n}\n\nfunction loadEvents(): WallEvent[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return [];\n    const parsed = JSON.parse(raw);\n    if (!Array.isArray(parsed)) return [];\n    return parsed.filter((e: any) => e && typeof e.title === 'string' && typeof e.date === 'string');\n  } catch {\n    return [];\n  }\n}\n\nfunction saveEvents(events: WallEvent[]) {\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(events));\n  } catch {\n    // storage unavailable — drop silently, never crash\n  }\n}\n\n// Build a 6x7 grid so all months keep the same tile height (stable 3D wall).\nfunction buildMonthGrid(year: number, month: number): (Date | null)[] {\n  const first = new Date(year, month, 1);\n  const startOffset = first.getDay();\n  const daysInMonth = new Date(year, month + 1, 0).getDate();\n  const cells: (Date | null)[] = [];\n  for (let i = 0; i < startOffset; i++) cells.push(null);\n  for (let d = 1; d <= daysInMonth; d++) cells.push(new Date(year, month, d));\n  while (cells.length < 42) cells.push(null);\n  return cells;\n}\n\nexport function getEventsForDay(events: WallEvent[], date: string): WallEvent[] {\n  return events\n    .filter(e => e.date === date)\n    .sort((a, b) => (a.time || '').localeCompare(b.time || ''));\n}\n\nexport function MonthWall({ accent = ACCENT, onMonthChange, renderDay }: MonthWallProps) {\n  const [events, setEvents] = useState<WallEvent[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [viewDate, setViewDate] = useState(() => new Date());\n  const [openDate, setOpenDate] = useState<string | null>(null);\n  const [undoId, setUndoId] = useState<string | null>(null);\n  const [form, setForm] = useState({ title: '', category: 'study', time: '' });\n  const undoRef = useRef<WallEvent | null>(null);\n  const inputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    try {\n      setEvents(loadEvents());\n      setError(null);\n    } catch (e: any) {\n      setError(e?.message || 'Could not load month events');\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  // Undo pill auto-dismiss\n  useEffect(() => {\n    if (!undoId) return;\n    const t = setTimeout(() => setUndoId(null), 5000);\n    return () => clearTimeout(t);\n  }, [undoId]);\n\n  // Focus the title input when a day popover opens\n  useEffect(() => {\n    if (openDate) {\n      const t = setTimeout(() => inputRef.current?.focus(), 60);\n      return () => clearTimeout(t);\n    }\n  }, [openDate]);\n\n  const year = viewDate.getFullYear();\n  const month = viewDate.getMonth();\n\n  useEffect(() => {\n    onMonthChange?.(`${year}-${String(month + 1).padStart(2, '0')}`);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [year, month]);\n\n  const grid = useMemo(() => buildMonthGrid(year, month), [year, month]);\n  const todayKey = localDateKey(new Date());\n\n  const eventsByDate = useMemo(() => {\n    const map: Record<string, WallEvent[]> = {};\n    for (const e of events) {\n      if (!map[e.date]) map[e.date] = [];\n      map[e.date].push(e);\n    }\n    for (const k of Object.keys(map)) {\n      map[k].sort((a, b) => (a.time || '').localeCompare(b.time || ''));\n    }\n    return map;\n  }, [events]);\n\n  const nav = (dir: number) => setViewDate(new Date(year, month + dir, 1));\n  const goToday = () => setViewDate(new Date());\n\n  const addEvent = () => {\n    if (!openDate || !form.title.trim()) return;\n    const ev: WallEvent = {\n      id: crypto.randomUUID(),\n      date: openDate,\n      title: form.title.trim(),\n      category: form.category || 'study',\n      time: form.time || undefined,\n      createdAt: new Date().toISOString(),\n    };\n    const next = [...events, ev];\n    setEvents(next);\n    saveEvents(next);\n    setForm({ title: '', category: 'study', time: '' });\n    setOpenDate(null);\n  };\n\n  const deleteEvent = (id: string) => {\n    const target = events.find(e => e.id === id);\n    if (target) undoRef.current = target;\n    setUndoId(id);\n    const next = events.filter(e => e.id !== id);\n    setEvents(next);\n    saveEvents(next);\n  };\n\n  const undoDelete = () => {\n    const target = undoRef.current;\n    if (target) {\n      const next = [...events, target];\n      setEvents(next);\n      saveEvents(next);\n    }\n    setUndoId(null);\n    undoRef.current = null;\n  };\n\n  const openDay = (date: string) => {\n    setOpenDate(date);\n    setForm({ title: '', category: 'study', time: '' });\n  };\n\n  const dayEvents = openDate ? getEventsForDay(events, openDate) : [];\n\n  // Color helper — category hues ONLY from CATEGORY_COLORS\n  const hueFor = (category: string): string => {\n    const c = CATEGORY_COLORS as Record<string, string>;\n    return c[category] || c.other || ACCENT;\n  };\n\n  const renderCell = (day: Date, key: string, isToday: boolean, isPast: boolean, list: WallEvent[]) => {\n    if (renderDay) {\n      return renderDay({ date: key, events: list, isToday, isPast });\n    }\n    const dots = list.slice(0, 2);\n    const overflow = list.length - dots.length;\n    return (\n      <motion.button\n        whileHover={{ y: -2 }}\n        whileTap={{ scale: 0.95 }}\n        onClick={() => openDay(key)}\n        className={`relative h-11 rounded-lg border flex flex-col items-center justify-center transition-colors group cursor-pointer\n          ${isToday ? 'bg-amber-500/20 border-amber-500/40 text-amber-200'\n            : isPast ? 'border-zinc-800/60 bg-zinc-900/40 text-zinc-500 hover:border-zinc-700'\n              : 'border-zinc-800/60 bg-zinc-900/20 text-zinc-300 hover:border-zinc-700/60 hover:bg-zinc-900/40'}`}\n        aria-label={day.toLocaleDateString()}\n      >\n        <span className={`text-[11px] leading-none ${isToday ? 'font-bold' : 'font-medium'}`}>{day.getDate()}</span>\n        {list.length > 0 ? (\n          <div className=\"flex items-center gap-0.5 mt-1\">\n            {dots.map(d => (\n              <span key={d.id} className=\"w-1.5 h-1.5 rounded-full\" style={{ backgroundColor: hueFor(d.category) }} />\n            ))}\n            {overflow > 0 && <span className=\"text-[9px] leading-none text-zinc-500\">+{overflow}</span>}\n          </div>\n        ) : (\n          <span className=\"mt-1 h-1.5 w-1.5 rounded-full opacity-0 group-hover:opacity-60 transition-opacity\" style={{ backgroundColor: accent }} />\n        )}\n      </motion.button>\n    );\n  };\n\n  return (\n    <div data-monthwall=\"wall\" className=\"relative rounded-xl overflow-hidden border border-zinc-800/50 bg-zinc-900/30 p-5\">\n      <div className=\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-amber-500/30 via-amber-500/10 to-transparent\" />\n\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"w-8 h-8 rounded-lg flex items-center justify-center\" style={{ backgroundColor: ACCENT_SOFT, border: `1px solid ${accent}55` }}>\n            <CalendarDays size={15} style={{ color: accent }} />\n          </div>\n          <div>\n            <h3 className=\"text-[15px] font-semibold text-zinc-100\">Month Wall</h3>\n            <p className=\"text-[11px] text-zinc-500\">\n              {events.length === 0 ? 'Tap a day to add an event' : `${events.length} event${events.length > 1 ? 's' : ''} this view`}\n            </p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-1\">\n          <motion.button whileTap={{ scale: 0.9 }} onClick={goToday}\n            className=\"h-8 px-2 rounded-md bg-zinc-800/50 text-[11px] text-zinc-300 hover:text-white border border-zinc-700/50 hover:border-zinc-600 transition-colors\">\n            Today\n          </motion.button>\n          <motion.button whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }} onClick={() => nav(-1)}\n            className=\"w-8 h-8 rounded-md bg-zinc-800/50 flex items-center justify-center text-zinc-400 hover:text-white border border-zinc-700/50 transition-colors\"\n            aria-label=\"Previous month\">\n            <ChevronLeft size={14} />\n          </motion.button>\n          <motion.button whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }} onClick={() => nav(1)}\n            className=\"w-8 h-8 rounded-md bg-zinc-800/50 flex items-center justify-center text-zinc-400 hover:text-white border border-zinc-700/50 transition-colors\"\n            aria-label=\"Next month\">\n            <ChevronRight size={14} />\n          </motion.button>\n        </div>\n      </div>\n\n      {/* Month / Year label */}\n      <div className=\"flex items-center justify-center mb-3\">\n        <span className=\"text-[13px] font-semibold text-zinc-200\">{MONTHS[month]} {year}</span>\n      </div>\n\n      {/* Weekday header */}\n      <div className=\"grid grid-cols-7 gap-1 mb-1\">\n        {DAY_LETTER.map((d, i) => (\n          <div key={i} className=\"text-center text-[10px] font-medium text-zinc-600 uppercase tracking-wider\">{d}</div>\n        ))}\n      </div>\n\n      {/* States */}\n      {loading ? (\n        <div className=\"animate-pulse space-y-1.5\" data-monthwall-state=\"loading\">\n          <div className=\"grid grid-cols-7 gap-1\">\n            {Array.from({ length: 42 }).map((_, i) => (\n              <div key={i} className=\"h-11 rounded-lg bg-zinc-800/40\" />\n            ))}\n          </div>\n        </div>\n      ) : error ? (\n        <div className=\"flex flex-col items-center justify-center py-10 text-center\" data-monthwall-state=\"error\">\n          <div className=\"w-12 h-12 rounded-full bg-zinc-800/50 flex items-center justify-center mb-2\">\n            <CalendarDays size={22} className=\"text-zinc-600\" />\n          </div>\n          <p className=\"text-[13px] font-medium text-zinc-400\">Could not load month</p>\n          <p className=\"text-[11px] text-zinc-600 mt-1 max-w-[240px]\">{error}</p>\n        </div>\n      ) : (\n        /* 3D wall — 6x7 stable grid */\n        <div className=\"relative\" style={{ perspective: 900 }}>\n          <div className=\"grid grid-cols-7 gap-1\" style={{ transform: 'rotateX(8deg)', transformStyle: 'preserve-3d' }}>\n            {grid.map((day, idx) => {\n              if (!day) {\n                return <div key={`empty-${idx}`} className=\"h-11\" />;\n              }\n              const key = localDateKey(day);\n              const isToday = key === todayKey;\n              const isPast = key < todayKey;\n              const list = eventsByDate[key] || [];\n\n              return (\n                <Popover key={key} open={openDate === key} onOpenChange={(o) => (o ? openDay(key) : setOpenDate(null))}>\n                  <PopoverTrigger asChild>{renderCell(day, key, isToday, isPast, list)}</PopoverTrigger>\n                  <PopoverContent className=\"w-72 bg-zinc-900 border-zinc-800 text-zinc-200\">\n                    <DayPanel\n                      date={day} events={getEventsForDay(events, key)} hueFor={hueFor}\n                      form={form} setForm={setForm} onSave={addEvent} onDelete={deleteEvent}\n                      inputRef={inputRef}\n                    />\n                  </PopoverContent>\n                </Popover>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* Empty CTA (invites first event on today) */}\n      {!loading && !error && events.length === 0 && (\n        <div className=\"mt-3 flex justify-center\">\n          <button\n            onClick={() => openDay(todayKey)}\n            className=\"px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 hover:bg-amber-500/20 transition-colors text-[11px] font-medium flex items-center gap-1\"\n          >\n            <Plus size={11} /> Add today's event\n          </button>\n        </div>\n      )}\n\n      {/* Undo pill */}\n      <AnimatePresence>\n        {undoId && (\n          <motion.div\n            initial={{ opacity: 0, y: 12 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: 12 }}\n            className=\"absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-3 px-3 py-2 rounded-lg bg-zinc-800 border border-zinc-700 shadow-xl shadow-black/40\"\n          >\n            <span className=\"text-[11px] text-zinc-300\">Event deleted</span>\n            <button onClick={undoDelete} className=\"text-[11px] font-medium text-amber-400 hover:text-amber-300\">Undo</button>\n            <button onClick={() => setUndoId(null)} className=\"text-zinc-500 hover:text-zinc-300\"><X size={12} /></button>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n\n/* ── Day popover panel: event list + add form (delete + undo) ── */\ninterface DayPanelProps {\n  date: Date;\n  events: WallEvent[];\n  hueFor: (cat: string) => string;\n  form: { title: string; category: string; time: string };\n  setForm: (f: any) => void;\n  onSave: () => void;\n  onDelete: (id: string) => void;\n  inputRef: React.RefObject<HTMLInputElement | null>;\n}\n\nfunction DayPanel({ date, events, hueFor, form, setForm, onSave, onDelete, inputRef }: DayPanelProps) {\n  const [deletingId, setDeletingId] = useState<string | null>(null);\n  const monthName = MONTHS[date.getMonth()];\n  const dayName = date.toLocaleDateString(undefined, { weekday: 'long' });\n  const categoryKeys = Object.keys(CATEGORY_COLORS as Record<string, string>);\n\n  return (\n    <div className=\"space-y-3\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <p className=\"text-[13px] font-semibold text-zinc-100\">{dayName}</p>\n          <p className=\"text-[11px] text-zinc-500\">{monthName} {date.getDate()}</p>\n        </div>\n        {events.length > 0 && (\n          <span className=\"text-[10px] text-zinc-500 bg-zinc-800/60 px-1.5 py-0.5 rounded\">\n            {events.length} event{events.length > 1 ? 's' : ''}\n          </span>\n        )}\n      </div>\n\n      {/* Event list */}\n      {events.length === 0 ? (\n        <div className=\"py-2 flex items-center justify-center\">\n          <div className=\"flex items-center gap-1.5 text-zinc-600 text-[11px]\">\n            <Sun size={12} /> No events — add one below\n          </div>\n        </div>\n      ) : (\n        <div className=\"space-y-1.5 max-h-[150px] overflow-y-auto\">\n          {events.map(e => (\n            <div key={e.id} className=\"group flex items-center gap-2 p-2 rounded-lg bg-zinc-900/60 border border-zinc-800/60\">\n              <span className=\"w-1.5 h-1.5 rounded-full shrink-0\" style={{ backgroundColor: hueFor(e.category) }} />\n              <span className=\"flex-1 min-w-0\">\n                <span className=\"block text-[12px] text-zinc-200 truncate\">{e.title}</span>\n                {e.time && <span className=\"block text-[10px] text-zinc-500 font-mono\">{e.time}</span>}\n              </span>\n              <button\n                onClick={() => {\n                  if (deletingId === e.id) { onDelete(e.id); setDeletingId(null); }\n                  else { setDeletingId(e.id); setTimeout(() => setDeletingId(p => p === e.id ? null : p), 3000); }\n                }}\n                className={`w-6 h-6 rounded flex items-center justify-center transition-colors ${deletingId === e.id ? 'bg-red-500/20 text-red-400' : 'bg-zinc-800/50 text-zinc-500 hover:text-red-400 opacity-0 group-hover:opacity-100'}`}\n                aria-label={`Delete ${e.title}`}\n              >\n                <Trash2 size={11} />\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Add form */}\n      <div className=\"pt-2 border-t border-zinc-800/60 space-y-2\">\n        <input\n          ref={inputRef}\n          value={form.title}\n          onChange={e => setForm((p: any) => ({ ...p, title: e.target.value }))}\n          onKeyDown={e => { if (e.key === 'Enter') onSave(); }}\n          placeholder=\"Event title (e.g. Linear Algebra)\"\n          className=\"w-full h-8 px-2 rounded-lg bg-zinc-900/80 border border-zinc-700/50 focus:border-amber-500/50 focus:ring-2 focus:ring-amber-500/20 outline-none text-[12px] text-zinc-200 placeholder:text-zinc-600\"\n        />\n        <div className=\"flex items-center gap-2\">\n          <Select value={form.category} onValueChange={(v: any) => setForm((p: any) => ({ ...p, category: v }))} className=\"flex-1 h-8\">\n            {categoryKeys.map(cat => (\n              <SelectItem key={cat} value={cat}>\n                <span className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: hueFor(cat) }} />\n                  {cat}\n                </span>\n              </SelectItem>\n            ))}\n          </Select>\n          <input\n            type=\"time\"\n            value={form.time || ''}\n            onChange={e => setForm((p: any) => ({ ...p, time: e.target.value }))}\n            className=\"h-8 px-2 rounded-lg bg-zinc-900/80 border border-zinc-700/50 focus:border-amber-500/50 outline-none text-[11px] text-zinc-300 w-[72px]\"\n            aria-label=\"Event time (optional)\"\n          />\n        </div>\n        <button\n          onClick={onSave}\n          disabled={!form.title.trim()}\n          className=\"w-full h-8 rounded-lg flex items-center justify-center gap-1 text-[12px] font-medium transition-colors disabled:opacity-40 bg-amber-500/20 text-amber-300 border border-amber-500/30 hover:bg-amber-500/30\"\n        >\n          <Plus size={12} /> Add event\n        </button>\n      </div>\n    </div>\n  );\n}\n",
  "filePath": "C:\\Users\\cleme\\Documents\\COMPUTAH_SAYENCE\\App Tracker\\src\\components\\MonthWall\\MonthWall.tsx"
}
