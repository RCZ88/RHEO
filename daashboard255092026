906:         iterations++;
907:         const hourFloor = Math.floor(cur / 3600000) * 3600000;
908:         const hourEndMs = hourFloor + 3600000;
909:         const segEnd = Math.min(ceiling, hourEndMs);
910:         const segSec = (segEnd - cur) / 1000;
