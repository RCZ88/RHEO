{
  "name": "rheo",
  "productName": "RHEO",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "DeskFlow Team",
  "desktopName": "rheo.desktop",
  "description": "Productivity time tracker for desktop apps and browser",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:prompt": "node scripts/check-default-prompt.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.rheo.app",
    "productName": "RHEO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/active-win/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "RHEO_AppIcon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "RHEO_AppIcon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Utility",
      "maintainer": "DeskFlow Team",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elucim/core": "^0.24.0",
    "@elucim/dsl": "^0.24.0",
    "@openrouter/sdk": "^0.12.16",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "@types/three": "^0.183.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "active-win": "^8.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "archiver": "^8.0.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.9.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape-dagre": "^4.0.0",
    "d3-force-3d": "^3.0.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "framer-motion": "^12.35.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.4",
    "jszip": "^3.10.2",
    "katex": "^0.17.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.12",
    "mermaid": "^11.16.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "node-imap": "^0.9.6",
    "node-pty": "^1.1.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "r3f-perf": "^7.2.3",
    "react": "^19.2.0",
    "react-bits": "^1.0.5",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.4",
    "reaviz": "^16.2.2",
    "recharts": "^3.10.1",
    "simple-icons": "^13.21.0",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1",
    "tabulator-tables": "^6.5.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "ts-fsrs": "^5.4.1",
    "tsdav": "^2.3.0",
    "vega-embed": "^7.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "asar": "^3.2.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "madge": "^8.0.0",
    "playwright": "^1.62.1",
    "shadcn": "^4.16.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "allowScripts": {
    "active-win@8.2.1": true,
    "better-sqlite3@12.9.0": true,
    "node-pty@1.1.0": true,
    "electron@41.1.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.4": true,
    "sqlite3@6.0.1": true,
    "@openrouter/sdk@0.12.16": true,
    "electron-winstaller@5.4.0": true
  }
}
